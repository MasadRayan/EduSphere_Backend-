# App
NODE_ENV=development
PORT=8000

# Database
# Prisma supports PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See: https://pris.ly/d/connection-strings
# Local example (prisma migrate dev will create DB if missing):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ph_healthcare?schema=public"
# Pooled / hosted example (Prisma Postgres, Supabase, Neon, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require&pgbouncer=true"

# Auth - JWT
# Generate fresh secrets before deploying:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=e077e5e5dffe46d3b1684624a350a88c9c5286d1240853c07e7529e18f7c80a2
JWT_REFRESH_SECRET=883b517a1ae41b1b460d5eef6d3b329f2fbc56a35317671253425a05da584b6c
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=10

# URLs
# Used to build absolute links back to this API (not read anywhere yet).
BACKEND_URL=http://localhost:8000
# Allowed CORS origin for the browser client.
FRONTEND_URL=http://localhost:3000

# Email (Gmail SMTP)
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
# Optional — defaults to SMTP_USER when unset
EMAIL_SENDER=you@gmail.com


# Redis
REDIS_USER=default
REDIS_PASSWORD=your-redis-password
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth (required for /auth/google-login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Seed Accounts (created on server startup)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123
TEACHER_NAME=Teacher
TEACHER_EMAIL=teacher@gmail.com
TEACHER_PASSWORD=Teacher@123
# Department used for the seeded teacher's instructor profile
SEED_DEPARTMENT_NAME=Computer Science
SEED_DEPARTMENT_CODE=CSE
