# App
NODE_ENV=development
PORT=8000

# Database
# Prisma supports PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See: https://pris.ly/d/connection-strings
# Local example (prisma migrate dev will create DB if missing):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusphere?schema=public"
# Pooled / hosted example (Prisma Postgres, Supabase, Neon, etc.):
# DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require&pgbouncer=true"

# Auth - JWT
# Generate fresh secrets before deploying:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-character-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-character-hex-string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=10

# URLs
# Public origin of this API. Used as a bKash redirect fallback when no
# payment result URL is set.
BACKEND_URL=http://localhost:8000
# Allowed CORS origin for the browser client. Scheme, host and port only, no path.
FRONTEND_URL=http://localhost:3000
# Where bKash sends the browser after a payment attempt. Include the full path to
# the result page so both success and failure land on it directly.
PAYMENT_RESULT_URL=http://localhost:3000/student/payment-result

# Email (Gmail SMTP)
# Server startup verifies this connection, so use a real app password locally.
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
# Optional — defaults to SMTP_USER when unset
EMAIL_SENDER=you@gmail.com


# Redis
# Server startup verifies this connection, so use reachable credentials locally.
REDIS_USER=default
REDIS_PASSWORD=your-redis-password
REDIS_HOST=localhost
REDIS_PORT=6379
# Alternatively, use a provider URL such as rediss://default:password@host:port
# REDIS_URL=rediss://default:your-redis-password@your-redis-host:6379

# Google OAuth (required for /auth/google-login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary (required for profile image and resume uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# bKash (required for semester enrollment payments)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
# bKash redirects the browser here. It must resolve from the browser, so use a
# public tunnel (ngrok/cloudflared) when testing payments locally.
BKASH_CALLBACK_URL=http://localhost:8000/api/course-registrations/bkash/callback

# Payments
CREDIT_FEE_RATE=2000
MAX_CREDITS_PER_SEMESTER=25

# Seed Accounts (created on server startup)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123
TEACHER_NAME=Teacher
TEACHER_EMAIL=teacher@gmail.com
TEACHER_PASSWORD=Teacher@123
# Department used for the seeded teacher's instructor profile
SEED_DEPARTMENT_NAME=Computer Science
SEED_DEPARTMENT_CODE=CSE
# Academic seed data (semester, course, section) linked to the department above.
# Every value below has the same fallback in src/app/config/index.ts.
SEED_SEMESTER_NAME=Fall
SEED_SEMESTER_YEAR=2026
SEED_COURSE_CODE=CSE101
SEED_COURSE_TITLE=Introduction to Programming
SEED_COURSE_CREDIT_HOURS=3
SEED_SECTION_CODE=A
SEED_SECTION_CAPACITY=40
# Students' fixed academic section (program + enrollment year + section code)
SEED_STUDENT_SECTION_CODE=A

# Production (set these in your hosting provider's environment settings):
# NODE_ENV=production
# BACKEND_URL=https://<backend-domain>
# FRONTEND_URL=https://<frontend-domain>
# PAYMENT_RESULT_URL=https://<frontend-domain>/student/payment-result
# BKASH_CALLBACK_URL=https://<backend-domain>/api/course-registrations/bkash/callback
