model Department {
  id   String @id @default(uuid())
  name String @unique
  code String @unique

  programs    Program[]
  courses     Course[]
  students    StudentProfile[]
  instructors InstructorProfile[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}