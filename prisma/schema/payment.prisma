model Payment {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount   Float
  currency String @default("usd")
  purpose  PaymentPurpose

  stripePaymentId String?       @unique
  stripeSessionId String?       @unique
  status          PaymentStatus @default(PENDING)

  // bKash tokenized checkout fields
  bkashPaymentId        String?      @unique
  bkashTrxId            String?      @unique
  merchantInvoiceNumber String?      @unique
  bkashStatus           String?
  bkashGatewayResponse  Json?
  refundTrxId           String?
  refundedAt            DateTime?

  courseRegistrationId String? @unique
  courseRegistration   CourseRegistration? @relation(fields: [courseRegistrationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("payments")
}