model Semester {
  id        String   @id @default(uuid())
  name      String // e.g. "Fall", "Spring"
  year      Int
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, year])
  @@map("semesters")
}