model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId String @unique @default(uuid()) // university roll/registration number
  fullName  String
  phone     String?
  avatarUrl String? // Cloudinary URL
  avatarPublicId String? // Cloudinary public_id for cleanup

  studentStatus StudentStatus @default(PENDING)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  currentSemesterId String?
  currentSemester   Semester? @relation(fields: [currentSemesterId], references: [id], onDelete: SetNull)

  sectionId String?
  section   StudentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  enrollmentYear Int
  cgpa           Float @default(0)

  registrations CourseRegistration[]
  attendances   Attendance[]
  results       Result[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([programId])
  @@index([currentSemesterId])
  @@index([sectionId])
  @@map("student_profiles")
}