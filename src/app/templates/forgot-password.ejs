<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset your EduSphere password</title>
</head>
<body style="margin:0;padding:0;background-color:#0a1120;font-family:Helvetica,Arial,sans-serif;">
  <div style="max-width:600px;margin:0 auto;padding:32px 24px;">
    <div style="background:#fffcf7;border-radius:20px;padding:36px 32px;text-align:center;border:1px solid rgba(212,168,83,0.28);">
      <div style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#17355e;font-weight:700;opacity:0.7;margin-bottom:12px;">Password Reset · Expires in <%= expirationMinutes %> minutes</div>
      <h1 style="margin:0;font-size:28px;line-height:32px;color:#0a1120;">Hello <%= name %>, here is your code</h1>
      <p style="font-size:14px;line-height:22px;color:#4b5563;max-width:420px;margin:14px auto 0;">Use the OTP below to reset your password. It is single-use.</p>
      <div style="margin:22px auto 0;background:#0a1120;color:#fffcf7;font-family:Menlo,monospace;font-size:28px;font-weight:700;letter-spacing:0.2em;border-radius:12px;padding:16px 12px;max-width:320px;"><%= otp %></div>
      <div style="margin-top:14px;font-size:12px;color:#6b7280;">If you did not request this, you can safely ignore this email.</div>
    </div>
    <div style="text-align:center;margin-top:16px;font-size:11px;color:rgba(255,252,247,0.55);">© <%= new Date().getFullYear() %> EduSphere, Inc.</div>
  </div>
</body>
</html>
