<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>Verify your EduSphere email</title>

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,ital,wght@9..144,0,700;9..144,1,700&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@700&display=swap");
      html, body { margin: 0 !important; padding: 0 !important; height: 100% !important; width: 100% !important; }
      * { -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; }
      table, td { mso-table-lspace: 0pt !important; mso-table-rspace: 0pt !important; }
      img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
      a { text-decoration: none; }
      @media screen and (max-width: 600px) {
        .wrapper { padding: 16px 12px !important; }
        .card { border-radius: 18px !important; }
        .card-inner { padding: 28px 20px 24px !important; }
        .hero-title { font-size: 28px !important; line-height: 30px !important; }
        .otp-tile { width: 44px !important; height: 52px !important; font-size: 20px !important; }
        .hide-mobile { display: none !important; }
        .stack { display: block !important; width: 100% !important; }
      }
      @media (prefers-color-scheme: dark) {
        .bg-canvas { background: #0a1120 !important; }
      }
    </style>
  </head>
  <body style="margin:0; padding:0; background-color:#0a1120;" class="bg-canvas">
    <!-- Preheader (hidden) -->
    <div style="display:none; visibility:hidden; opacity:0; color:transparent; height:0; width:0; overflow:hidden; mso-hide:all;">
      Your EduSphere verification code is <%= otp %> — expires in <%= expirationMinutes %> minutes. Confirm your seat.
    </div>

    <!-- Full width canvas -->
    <center role="article" aria-roledescription="email" lang="en" dir="ltr" style="width:100%; background-color:#0a1120; background-image: radial-gradient(circle at 1px 1px, rgba(212,168,83,0.12) 1px, transparent 0); background-size: 22px 22px;">
      <div style="max-width: 600px; margin: 0 auto;" class="wrapper">
        <!--[if mso]>
        <table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td>
        <![endif]-->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin:0 auto;">
          <!-- Top meta bar -->
          <tr>
            <td style="padding: 28px 24px 18px; text-align: center;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left" style="vertical-align: middle;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="vertical-align: middle; padding-right: 10px;">
                          <!-- Sphere mark -->
                          <div style="width:36px; height:36px; border-radius:50%; background: linear-gradient(135deg, #d4a853 0%, #be9a5e 100%); border:1.5px solid rgba(255,255,255,0.9); position:relative; text-align:center; line-height:36px; font-family: 'Fraunces', Georgia, serif; font-weight:700; font-size:16px; color:#0a1120;">◐</div>
                        </td>
                        <td style="vertical-align: middle;">
                          <div style="font-family: 'Fraunces', Georgia, serif; font-weight:700; font-size:18px; letter-spacing:-0.02em; color:#fffcf7; line-height:1;">EduSphere</div>
                          <div style="font-family: 'Instrument Sans', Helvetica, Arial, sans-serif; font-size:9px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,252,247,0.6); font-weight:600; margin-top:2px;">Academic Operating System</div>
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td align="right" style="vertical-align: middle;" class="hide-mobile">
                    <div style="display:inline-block; border:1px solid rgba(212,168,83,0.35); background: rgba(212,168,83,0.12); border-radius:100px; padding:6px 12px; font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:#d4a853; font-weight:600;">●&nbsp; Admission &nbsp;·&nbsp; Step 2 of 3</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Card -->
          <tr>
            <td style="padding: 0 16px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#fffcf7; border-radius:20px; overflow:hidden; border:1px solid rgba(212,168,83,0.28); box-shadow: 0 24px 48px rgba(0,0,0,0.35), 0 1px 0 rgba(212,168,83,0.2) inset;" class="card">
                <!-- Gold top rule -->
                <tr>
                  <td style="height:4px; line-height:4px; background: linear-gradient(90deg, #d4a853 0%, #be9a5e 25%, #17355e 100%); font-size:0;">&nbsp;</td>
                </tr>

                <!-- Hero -->
                <tr>
                  <td style="padding: 30px 36px 0;" class="card-inner">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" style="padding-bottom: 18px;">
                          <!-- Orbital Diagram -->
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td align="center">
                                <div style="position:relative; width:86px; height:86px; margin:0 auto;">
                                  <!-- circles via borders -->
                                  <div style="width:86px; height:86px; border-radius:50%; border:1px dashed rgba(23,53,94,0.18); position:relative; box-sizing:border-box;">
                                    <div style="position:absolute; inset:14px; border-radius:50%; border:1px solid rgba(212,168,83,0.35);"></div>
                                    <div style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:38px; height:38px; border-radius:50%; background:#0a1120; border:2px solid #d4a853; text-align:center; line-height:36px; font-size:16px; color:#d4a853;">✦</div>
                                    <!-- orbit dots -->
                                    <div style="position:absolute; width:7px; height:7px; border-radius:50%; background:#17355e; top:4px; left:50%; transform:translateX(-50%); border:2px solid #fffcf7;"></div>
                                    <div style="position:absolute; width:5px; height:5px; border-radius:50%; background:#d4a853; bottom:10px; right:10px;"></div>
                                  </div>
                                </div>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                      <tr>
                        <td align="center">
                          <div style="font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:10px; letter-spacing:0.2em; text-transform:uppercase; color:#17355e; font-weight:700; opacity:0.7; margin-bottom:10px;">Verification Required &nbsp;·&nbsp; Dossier #<%= otp.toString().slice(0,3) %>-<%= new Date().getFullYear() %></div>
                          <h1 class="hero-title" style="margin:0; font-family:'Fraunces', Georgia, serif; font-size:32px; line-height:31px; letter-spacing:-0.03em; color:#0a1120; font-weight:700;">
                            Your seat is<br />
                            <span style="font-style:italic; font-weight:700; color:#17355e; position:relative;">reserved<span style="display:inline-block; width:32px; height:3px; background:#d4a853; vertical-align:middle; margin-left:8px; border-radius:2px; position:relative; top:-2px;"></span></span> —<br />
                            just confirm it's you.
                          </h1>
                          <p style="margin:14px auto 0; max-width:420px; font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:14px; line-height:22px; color:#4b5563; font-weight:400;">
                            Hello <strong style="color:#0a1120; font-weight:600;"><%= name %></strong>, we held your place for <span style="color:#0a1120; border-bottom:1px dotted #d4a853;"><%= email %></span>. Enter the code below to activate your EduSphere enrollment.
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- OTP Ticket -->
                <tr>
                  <td style="padding: 22px 24px 0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center">
                          <div style="background:#ffffff; border:1px solid #e8e6e1; border-radius:16px; padding:18px 16px 16px; position:relative; overflow:hidden;">
                            <!-- subtle blueprint grid inside -->
                            <div style="position:absolute; inset:0; opacity:0.035; background-image: linear-gradient(#17355e 1px, transparent 1px), linear-gradient(90deg, #17355e 1px, transparent 1px); background-size: 18px 18px; pointer-events:none;"></div>
                            <!-- label -->
                            <div style="position:relative; font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:#6b7280; font-weight:700; margin-bottom:14px;">
                              <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#e94e1b; vertical-align:middle; margin-right:6px; position:relative; top:-1px;"></span>
                              Verification Code &nbsp;·&nbsp; Expires in <%= expirationMinutes %> minutes
                            </div>

                            <!-- Tiles -->
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto; position:relative;">
                              <tr>
                                <% const code = otp.toString(); for(let i=0; i<code.length; i++) { %>
                                  <td style="padding: 0 4px;">
                                    <div class="otp-tile" style="width:52px; height:60px; background:#0a1120; border:1px solid #1e2e4a; border-radius:10px; text-align:center; line-height:60px; font-family:'JetBrains Mono', Menlo, monospace; font-size:22px; font-weight:700; color:#fffcf7; letter-spacing:0.02em; box-shadow: 0 2px 0 rgba(212,168,83,0.45), 0 8px 16px rgba(10,17,32,0.18); position:relative;">
                                      <%= code[i] %>
                                      <span style="position:absolute; left:6px; right:6px; bottom:6px; height:1px; background: rgba(212,168,83,0.35);"></span>
                                    </div>
                                  </td>
                                  <% if(i < code.length - 1) { %>
                                    <td style="padding:0 1px; vertical-align:middle;">
                                      <div style="width:4px; height:4px; border-radius:50%; background:#d4a853; opacity:0.55;"></div>
                                    </td>
                                  <% } %>
                                <% } %>
                              </tr>
                            </table>

                            <!-- helper -->
                            <div style="position:relative; margin-top:14px; font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:12px; color:#6b7280; line-height:1;">
                              <span style="color:#4b5563;">Tap to copy</span> &nbsp;·&nbsp; <span style="font-variant-numeric: tabular-nums; background:#fff7e6; border:1px solid #fde68a; color:#92400e; padding:2px 8px; border-radius:100px; font-weight:600; font-size:11px;">⏱ <%= expirationMinutes %>:00 remaining</span>
                            </div>

                            <!-- perforation line -->
                            <div style="margin:18px -16px 0; border-top:1px dashed #d7d3c9; position:relative; height:1px;">
                              <span style="position:absolute; left:-1px; top:50%; transform:translateY(-50%); width:10px; height:20px; background:#fffcf7; border:1px solid #e8e6e1; border-left:0; border-radius:0 12px 12px 0;"></span>
                              <span style="position:absolute; right:-1px; top:50%; transform:translateY(-50%); width:10px; height:20px; background:#fffcf7; border:1px solid #e8e6e1; border-right:0; border-radius:12px 0 0 12px;"></span>
                            </div>

                            <!-- bottom meta -->
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px; position:relative;">
                              <tr>
                                <td align="left" style="font-family:'JetBrains Mono', Menlo, monospace; font-size:10px; color:#9ca3af; letter-spacing:0.06em; text-transform:uppercase;">
                                  To: <%= email %>
                                </td>
                                <td align="right" style="font-family:'JetBrains Mono', Menlo, monospace; font-size:10px; color:#9ca3af; letter-spacing:0.06em; text-transform:uppercase;">
                                  Ref: ES-<%= new Date().getFullYear() %>-<%= otp.toString().slice(-4) %>
                                </td>
                              </tr>
                            </table>
                          </div>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Instructions -->
                <tr>
                  <td style="padding: 18px 32px 0;" class="card-inner">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f8f7f5; border:1px solid #e8e6e1; border-radius:12px;">
                      <tr>
                        <td style="padding:14px 16px;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td style="width:28px; vertical-align:top; padding-top:2px;">
                                <div style="width:22px; height:22px; border-radius:50%; background:#17355e; color:#fffcf7; text-align:center; line-height:22px; font-size:11px; font-family:'Instrument Sans', sans-serif;">ⓘ</div>
                              </td>
                              <td style="font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:12.5px; line-height:18px; color:#374151; padding-left:8px;">
                                <strong style="color:#0a1120;">How to use:</strong> Return to EduSphere and paste the 6-digit code. Code is single-use and case-insensitive. If it expires, request a new one — no need to re-register.
                                <span style="display:block; margin-top:6px; color:#6b7280; font-size:11.5px;">Didn't create an account? You can safely ignore this. Your email will not be enrolled without verification. <a href="#" style="color:#17355e; text-decoration:underline; font-weight:600;">Report misuse</a>.</span>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Divider + support -->
                <tr>
                  <td style="padding: 20px 36px 0;" class="card-inner">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="border-top:1px solid #e8e6e1; padding-top:16px;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td class="stack" style="vertical-align:top; width:50%; padding-right:12px;">
                                <div style="font-family:'JetBrains Mono', Menlo, monospace; font-size:9px; letter-spacing:0.14em; text-transform:uppercase; color:#9ca3af; font-weight:700; margin-bottom:6px;">Need help?</div>
                                <div style="font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:12.5px; line-height:18px; color:#4b5563;">
                                  <a href="mailto:support@edusphere.edu" style="color:#17355e; font-weight:600; text-decoration:none; border-bottom:1px solid rgba(23,53,94,0.2);">support@edusphere.edu</a> &nbsp;·&nbsp; Live chat in app
                                </div>
                              </td>
                              <td class="stack" align="right" style="vertical-align:top; width:50%; text-align:right; padding-top:4px;">
                                <div style="display:inline-block; text-align:left;">
                                  <div style="font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:11px; color:#6b7280; line-height:14px;">Issued by<br /><strong style="color:#0a1120; font-weight:700;">EduSphere Registrar</strong><br /><span style="font-size:10px; color:#9ca3af;">Dhaka · Boston · Remote</span></div>
                                </div>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Stamp footer inside card -->
                <tr>
                  <td style="padding: 18px 36px 26px;" class="card-inner">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" style="padding-top:6px;">
                          <div style="display:inline-block; border:1px solid rgba(23,53,94,0.12); border-radius:100px; padding:8px 14px; background:#ffffff;">
                            <span style="font-family:'JetBrains Mono', Menlo, monospace; font-size:9px; letter-spacing:0.16em; text-transform:uppercase; color:#6b7280;">Authenticated by EduSphere Trust &nbsp;·&nbsp; Encrypted &nbsp;·&nbsp; Private</span>
                          </div>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Outside footer -->
          <tr>
            <td style="padding: 16px 24px 32px; text-align:center;">
              <div style="font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:11px; line-height:18px; color:rgba(255,252,247,0.55); max-width:420px; margin:0 auto;">
                You received this because <strong style="color:rgba(255,252,247,0.85); font-weight:600;"><%= email %></strong> was used to start a registration at EduSphere. This code will expire in <%= expirationMinutes %> minutes and can only be used once.
              </div>
              <div style="margin-top:14px;">
                <a href="#" style="font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:11px; color:rgba(212,168,83,0.9); text-decoration:underline; margin:0 8px;">Privacy</a>
                <span style="color:rgba(255,252,247,0.2);">·</span>
                <a href="#" style="font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:11px; color:rgba(212,168,83,0.9); text-decoration:underline; margin:0 8px;">Terms</a>
                <span style="color:rgba(255,252,247,0.2);">·</span>
                <a href="#" style="font-family:'Instrument Sans', Helvetica, Arial, sans-serif; font-size:11px; color:rgba(255,252,247,0.6); text-decoration:none; margin:0 8px;">Unsubscribe</a>
              </div>
              <div style="margin-top:16px; font-family:'JetBrains Mono', Menlo, monospace; font-size:10px; letter-spacing:0.08em; text-transform:uppercase; color:rgba(255,252,247,0.32);">
                © <%= new Date().getFullYear() %> EduSphere, Inc. · 42 Academic Row, Learning District
              </div>
              <!-- small sphere mark repeated -->
              <div style="margin-top:14px; opacity:0.5;">
                <div style="display:inline-block; width:28px; height:28px; border-radius:50%; border:1px solid rgba(212,168,83,0.35); text-align:center; line-height:28px; font-size:12px; color:#d4a853;">◐</div>
              </div>
            </td>
          </tr>
        </table>
        <!--[if mso]></td></tr></table><![endif]-->
      </div>
    </center>
  </body>
</html>
