<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to EduSphere</title>
</head>
<body style="margin:0;padding:0;background-color:#0a1120;font-family:Helvetica,Arial,sans-serif;">
  <div style="max-width:600px;margin:0 auto;padding:32px 24px;">
    <div style="background:#fffcf7;border-radius:20px;padding:36px 32px;text-align:center;border:1px solid rgba(212,168,83,0.28);">
      <div style="font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#17355e;font-weight:700;opacity:0.7;margin-bottom:12px;">EduSphere · Academic Operating System</div>
      <h1 style="margin:0;font-size:30px;line-height:34px;color:#0a1120;">Welcome, <%= name %>!</h1>
      <p style="font-size:14px;line-height:22px;color:#4b5563;max-width:420px;margin:14px auto 0;">
        Your email is verified and your EduSphere student account is now active.
        You can log in, complete your profile, and start enrolling in courses.
      </p>
      <div style="margin-top:20px;font-size:12px;color:#6b7280;">Need help? Contact <a href="mailto:support@edusphere.edu" style="color:#17355e;font-weight:600;">support@edusphere.edu</a></div>
    </div>
    <div style="text-align:center;margin-top:16px;font-size:11px;color:rgba(255,252,247,0.55);">© <%= new Date().getFullYear() %> EduSphere, Inc.</div>
  </div>
</body>
</html>
