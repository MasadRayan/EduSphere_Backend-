{
  "version": 2,
  "builds": [
    {
      "src": "dist/vercel.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "src/app/templates/**",
          "node_modules/pdfkit/js/standard-fonts/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/vercel.cjs"
    }
  ]
}